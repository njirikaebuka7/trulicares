# Server Configuration
PORT=3001
NODE_ENV=development

# Database (Supabase / PostgreSQL)
DATABASE_URL=postgres://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase (Storage + Realtime). Service role key used server-side only.
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Authentication
JWT_SECRET=your_super_secret_jwt_key_here
APP_URL=http://localhost:5000
# Comma-separated allowlist of emails that become admin on signup. This is the ONLY
# way to grant admin — user-supplied role is never trusted. Existing admins are unaffected.
ADMIN_EMAILS=admin@trulicares.com

# Stripe Payments
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── Redis (Upstash recommended) ──────────────────────────────
# Shared by the API (cache + rate limiting + queue producer) and the worker.
# Leave unset to fall back to in-memory cache/rate-limiting (single-instance only).
REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379
# Force-disable Redis even if REDIS_URL is set (useful locally): true/false
# REDIS_DISABLED=false

# ── BullMQ background jobs ────────────────────────────────────
QUEUE_PREFIX=trulicares
WORKER_CONCURRENCY=5
# Run jobs (email/notifications) inline in the API instead of via a separate worker.
# Set to true when you are NOT running `npm run worker` (zero-extra-infra mode).
INLINE_JOBS=true
# Secret Vercel Cron sends as `Authorization: Bearer <value>` to /api/cron/cleanup.
CRON_SECRET=change_me_to_a_long_random_string

# ── Resend Email ──────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM_NAME=TruliCares
EMAIL_FROM_ADDRESS=noreply@trulicares.com
EMAIL_SUPPORT_ADDRESS=support@trulicares.com
EMAIL_ADMIN_ADDRESS=admin@trulicares.com
# Absolute URL to the logo used in email headers (must be publicly reachable)
EMAIL_LOGO_URL=https://www.trulicares.com/logo.png

# ── Geocoding (location picker + matching) ───────────────────
# 'nominatim' (free, OpenStreetMap, no key — default) or 'google'
GEOCODING_PROVIDER=nominatim
# Required only if GEOCODING_PROVIDER=google
GOOGLE_MAPS_API_KEY=
# Optional ISO country code to bias Nominatim forward search (e.g. 'us'); blank = global
GEOCODING_COUNTRY=

# ── Checkr background checks ─────────────────────────────────
# Leave CHECKR_API_KEY empty to keep the manual admin-approval fallback.
CHECKR_API_KEY=
CHECKR_WEBHOOK_SECRET=
CHECKR_ENV=test
CHECKR_PACKAGE=test_pro_criminal

# Frontend Configuration (Vite)
VITE_API_URL=http://localhost:3001
VITE_PORT=5000
